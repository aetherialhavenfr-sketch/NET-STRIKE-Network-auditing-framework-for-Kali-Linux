#!/usr/bin/env python3
import sys
a = sys.argv[1:]
if "--version" in a:
    print("Masscan version 1.3.2 ( https://github.com/robertdavidgraham/masscan )"); sys.exit(0)
sys.stderr.write("Starting masscan 1.3.2\nScanning 2 hosts [10000 ports/host]\nrate:  1.00-kpps, 100.00% done\n")
out = a[a.index("-oL") + 1]
with open(out, "w") as fh:
    fh.write("#masscan\n")
    for ip, ports in (("192.168.56.10", (135, 139, 445, 3389)), ("192.168.56.20", (21, 22, 80))):
        for p in ports:
            fh.write(f"open tcp {p} {ip} 1700000000\n")
    fh.write("# end\n")
