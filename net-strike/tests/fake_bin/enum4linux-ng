#!/usr/bin/env python3
import json, sys
a = sys.argv[1:]
if "--version" in a:
    print("enum4linux-ng 1.3.1"); sys.exit(0)
prefix = a[a.index("-oJ") + 1]
print("[*] Checking host " + a[a.index("-A") + 1])
data = {"sessions_possible": True,
        "smb_dialects": {"SMB 1.0": False, "SMB 2.0.2": True, "Signing required": False},
        "os_info": {"OS": "Windows Server 2019", "OS version": "10.0"},
        "smb_domain_info": {"Domain": "LAB"},
        "users": {"500": {"username": "Administrator"}, "1104": {"username": "alice"}},
        "groups": {"512": {"groupname": "Domain Admins"}},
        "shares": {"public": {"comment": "Public", "access": {"mapping": "ok", "listing": "ok", "writing": "denied"}},
                   "upload": {"comment": "", "access": {"mapping": "ok", "listing": "ok", "writing": "ok"}}}}
with open(prefix + ".json", "w") as fh:
    json.dump(data, fh)
